# Local defaults. Copy to an ignored .env for local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/oceanpulse_db
JWT_SECRET_KEY=

# Optional development station. Choose a unique password (16+ characters, letter + digit).
# The station is inserted at startup; existing accounts are never promoted or reset.
# Rejected outside development. Credentials are never logged.
DEV_SEED_COASTGUARD=false
COASTGUARD_STATION_EMAIL=coastguard.hq@oceanpulse.gov
COASTGUARD_STATION_PASSWORD=
COASTGUARD_STATION_CONTACT=

# Optional services: weather returns 503 without its key; email settings are a pair.
WEATHER_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Choose resend for Resend delivery; sendgrid remains supported.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Replace with an address on the exact domain verified in Resend.
RESEND_FROM_EMAIL="OceanPulse <noreply@your-verified-domain.com>"
# Local UI testing only: print verification codes in the backend terminal.
# This setting is rejected outside NODE_ENV=development.
DEV_LOG_VERIFICATION_CODES=false
# Set true only for local console OTPs. It overrides the selected provider.
# For real emails: fill RESEND_* above, keep false, then restart the backend.

# Exact browser origins, comma separated. Required in production; no wildcards.
# Use none only for clients that omit Origin headers.
# React Native Android WebSockets send the API origin; include it explicitly.
# Native clients without Origin still require their normal access token.
# Include the API origin used by Android devices, as well as browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:3000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# Keep false for direct access. Set only trusted proxy IPs/CIDRs (or loopback).
TRUST_PROXY=false
LOG_LEVEL=info
MONGODB_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=30000
READINESS_TIMEOUT_MS=1500
SHUTDOWN_GRACE_MS=10000
